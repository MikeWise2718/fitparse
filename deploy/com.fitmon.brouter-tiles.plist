<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.fitmon.brouter-tiles</string>
    <key>UserName</key><string>mike</string>
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>/Users/mike/projects/fitparse/deploy/brouter/setup-brouter.sh</string></array>
    <!-- Monthly: brouter.de rebuilds the tiles from OpenStreetMap about weekly. -->
    <key>StartCalendarInterval</key>
    <dict><key>Day</key><integer>2</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>40</integer></dict>
    <key>StandardOutPath</key><string>/Users/mike/.fitmon/brouter-tiles.log</string>
    <key>StandardErrorPath</key><string>/Users/mike/.fitmon/brouter-tiles.log</string>
</dict>
</plist>
